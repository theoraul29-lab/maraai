# Multi-stage build for Node.js application
# Stage 1: Build
#
# Debian slim (glibc), not Alpine (musl) — sqlite-vec's prebuilt native
# extension (and other native deps we may add later) only ships glibc
# Linux binaries; musl loads them as garbage or segfaults. better-sqlite3
# itself works fine on either, so switching costs nothing there. Builder and
# runtime both use the same base so a native addon built/copied in one
# stage is guaranteed ABI-compatible in the other.
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Copy package files (root + frontend lockfiles) for deterministic installs
COPY package*.json ./

# Install dependencies deterministically from the lockfile
RUN npm ci

# Copy source code
COPY . .

# Build frontend (npm ci) + compile the backend to dist/ with esbuild
RUN npm run build

# Strip root devDependencies (esbuild/tsx/vite/@types/vitest are build-time
# only) so the runtime image ships production deps exclusively. Safe because
# the compiled backend never imports a devDep in production: server/vite.ts is
# behind a `NODE_ENV !== 'production'` dynamic import in server/index.ts.
RUN npm prune --omit=dev

# Stage 2: Runtime
FROM node:20-bookworm-slim

WORKDIR /app

# dumb-init: signal handling. gosu: dropping privileges at runtime (Debian's
# equivalent of Alpine's su-exec — same purpose, same call site below).
# python3: Mara's sandboxed script-execution tool (server/services/
# python-sandbox.ts) and the code-agent's syntax-check gate for .py changes.
# No pip packages installed — scripts run stdlib-only, deliberately, to keep
# the sandbox's dependency surface at zero.
RUN apt-get update \
    && apt-get install -y --no-install-recommends dumb-init gosu python3 \
    && rm -rf /var/lib/apt/lists/*

# Copy from builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/server ./server
COPY --from=builder /app/shared ./shared
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/migrations ./migrations

# Create nodejs user and give it /app ownership. /data is handled at entrypoint
# time because Railway mounts volumes as root at container start, which would
# mask any build-time chown.
RUN groupadd -g 1001 nodejs \
    && useradd -u 1001 -g nodejs -M -s /usr/sbin/nologin nodejs \
    && mkdir -p /data \
    && chown -R nodejs:nodejs /app /data

# Entrypoint script: ensure /data is writable by nodejs (required when a
# Railway Volume is mounted there), then drop privileges to nodejs before
# executing the real command.
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Health check (Railway injects PORT). start-period gives the boot sequence
# (migrations, seeding, knowledge-base writes — all synchronous, all before
# the server starts listening) room to finish before a slow check counts
# against --retries; a real incident (2026-09-17) showed a healthy-looking
# boot lose the race against Railway's own 30s healthcheckTimeout
# (railway.json — raised alongside this), so this is widened to match.
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD node -e "const p=process.env.PORT||5000;require('http').get('http://localhost:'+p+'/api/health',(r)=>{if(r.statusCode!==200)throw new Error(r.statusCode)})"

# Expose port
EXPOSE 5000

# dumb-init handles signals; entrypoint script fixes /data perms and drops
# to nodejs before running the app.
ENTRYPOINT ["dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]

# Start application
CMD ["npm", "run", "start"]
