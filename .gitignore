# Environment variables — never commit secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
venv/
venv_back/
whisper-env/
# Vendored FunAudioLLM/CosyVoice clone + its own venv + downloaded
# CosyVoice2-0.5B model weights (~5GB) — machine-specific local TTS
# backend for Control Center, same treatment as whisper-env/ above.
# cosyvoice_tts_server.py (the actual Mara-specific server code) lives
# inside this ignored folder too, for its relative-import paths into the
# cloned repo — see that file's own docstring for the run command.
server/stt/CosyVoice/
server/stt/cosyvoice-env/
__pycache__/
*.pyc
*.pyo

# Local STT model cache (downloaded on first run, machine-specific)
server/stt/models/

# Build outputs
dist/
frontend/dist/
functions/lib/
client/dist/

# Database files — contain production data
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
instance/

# Sensitive Kubernetes backup files containing credentials
backup_k8s_*.yaml
backup_k8s_.yaml

# Logs
logs/
*.log

# Misc
.DS_Store
*.local
data/
scripts/.smoke-credits-*.ts

# Debug / temporary files — not part of source
output.txt
screenshot-*.png
screenshot-*.jpg
